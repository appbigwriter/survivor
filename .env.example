# Copie para .env.local (desenvolvimento) ou cadastre no Easypanel (produção).

# Supabase self-hosted
SUPABASE_URL=https://supabase.seudominio.com.br
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (usado nos links de convite)
APP_URL=https://survivor.seudominio.com.br

# E-mail que vira administrador no primeiro cadastro (sem convite)
BOOTSTRAP_ADMIN_EMAIL=

# IA do modo padrão do sistema
# AI_PROVIDER=anthropic usa o SDK oficial da Anthropic.
# AI_PROVIDER=openai_compatible usa /chat/completions (OpenAI, OpenRouter, Groq, Gemini, Ollama...).
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_API_KEY=
# Atalho: com só OPENAI_API_KEY definida (e AI_PROVIDER/AI_API_KEY vazias), o app usa a OpenAI.
# Nesse caso AI_MODEL é obrigatória.
# OPENAI_API_KEY=
# Só para openai_compatible. Exemplo do Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
# Análises por IA por pessoa por dia no modo padrão
AI_DAILY_LIMIT=15

# Responsável pelos dados (aparece na política de privacidade)
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_CONTACT=
