{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "survivor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    },
    {
      "name": "survivor-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "survivor-standalone",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env.local", "--env-file=.next/standalone/.preview.env", ".next/standalone/server.js"],
      "port": 3100
    }
  ]
}
